{
  "rule_code": "E0125",
  "title": "E0125: Open redirect via header",
  "plain_english": "",
  "why_matters": "",
  "bad_example": "$url = $_GET['url'] ?? '';\nheader(\"Location: $url\");\nexit;",
  "good_example": "$url = $_GET['url'] ?? '';\n$allowed = ['/dashboard', '/profile', '/login'];\nif (!in_array($url, $allowed, true)) {\n    $url = '/dashboard';\n}\nheader(\"Location: $url\");\nexit;",
  "severity": "info",
  "category": "general",
  "what_it_checks": [
    "`header(\"Location: ...\")` with tainted input",
    "`header(\"refresh: ...;url=...\")` with tainted input"
  ]
}