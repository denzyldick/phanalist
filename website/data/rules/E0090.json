{
  "rule_code": "E0090",
  "title": "E0090: File write to user-controlled path",
  "plain_english": "",
  "why_matters": "",
  "bad_example": "$filename = $_GET['file'] ?? '';\n$content = $_GET['content'] ?? '';\nfile_put_contents(\"/var/www/files/$filename\", $content);",
  "good_example": "$filename = $_GET['file'] ?? '';\n$allowed = ['profile.txt', 'settings.txt'];\nif (!in_array($filename, $allowed, true)) {\n    http_response_code(400);\n    exit;\n}\nfile_put_contents(\"/var/www/files/$filename\", $content);",
  "severity": "info",
  "category": "general",
  "what_it_checks": [
    "`file_put_contents()`, `file()`, `fopen()` with `'w'`, `'w+'`, `'a'`, `'a+'` modes where the path is built from user-controlled input",
    "`file_get_contents()` used with write contexts (stream contexts)"
  ]
}