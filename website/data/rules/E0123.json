{
  "rule_code": "E0123",
  "title": "E0123: XSS via echo",
  "plain_english": "",
  "why_matters": "",
  "bad_example": "$name = $_GET['name'] ?? '';\necho \"Hello, $name\";\n// ?name=<script>stealCookies()</script>",
  "good_example": "$name = $_GET['name'] ?? '';\necho \"Hello, \" . htmlspecialchars($name, ENT_QUOTES, 'UTF-8');",
  "severity": "info",
  "category": "general",
  "what_it_checks": [
    "`echo`, `print`, `printf()`, `vprintf()` with tainted input",
    "`<?=$var ?>` short echo tags with unescaped variables"
  ]
}