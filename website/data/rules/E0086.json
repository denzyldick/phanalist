{
  "rule_code": "E0086",
  "title": "E0086: Deprecated session function",
  "plain_english": "",
  "why_matters": "",
  "bad_example": "session_register('username');\n$username = $_POST['username'] ?? '';\nif (session_is_registered('username')) {\n    // ...\n}\nsession_unregister('username');",
  "good_example": "$_SESSION['username'] = $_POST['username'] ?? '';\nif (isset($_SESSION['username'])) {\n    // ...\n}\nunset($_SESSION['username']);",
  "severity": "info",
  "category": "general",
  "what_it_checks": [
    "`session_register()`, `session_is_registered()`, `session_unregister()` function calls"
  ]
}